# MongoDB
MONGODB_URI=mongodb://localhost:27017/skytouchclean
MONGODB_DB=skytouchclean

# Session
SESSION_SECRET=your-session-secret-here-at-least-32-characters-long

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your-secret-key-here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-public-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First Admin (for seed)
ADMIN_EMAIL=admin@skytouchclean.com
