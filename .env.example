# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/skytouchclean?retryWrites=true&w=majority
MONGODB_DB=skytouchclean

# Session
SESSION_SECRET=your-session-secret-here-change-in-production

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your-secret-key-here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-public-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Email (if configured later)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
