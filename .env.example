# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/skytouchclean?retryWrites=true&w=majority
MONGODB_DB=skytouchclean

# Session
SESSION_SECRET=your-session-secret-here-change-in-production

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your-secret-key-here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-public-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email - Brevo (recommended)
# Get your API key from https://www.brevo.com/
BREVO_API_KEY=xkeysib-your-api-key-here
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_SENDER_NAME=SkyTouch
BREVO_SENDER_EMAIL=noreply@yourdomain.com

# Email - Resend (alternative)
# Get your API key from https://resend.com/api-keys
# RESEND_API_KEY=re_your-api-key-here
# RESEND_FROM_EMAIL=noreply@yourdomain.com

# First admin (for seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Admin User
